diff --git a/packages/client/ui-workspace/src/client/session-claims.ts b/packages/client/ui-workspace/src/client/session-claims.ts
new file mode 100644
index 0000000..e05eecb
--- /dev/null
+++ b/packages/client/ui-workspace/src/client/session-claims.ts
@@ -0,0 +1,61 @@
+import type { HostObservable } from '@deepseek-ai/dsh-client-ui-slots'
+import type { SessionId } from '@deepseek-ai/dsh-client-runtime/client'
+
+const EMPTY_SESSION_IDS: readonly SessionId[] = []
+
+/**
+ * Cross-plugin ownership ledger for sessions presented outside the ordinary
+ * workspace lists. Claiming changes presentation only: the Host session,
+ * workspace account, ordering, and archive state remain untouched.
+ */
+export interface WorkspaceSessionClaims extends HostObservable<readonly SessionId[]> {
+  /** Replace one plugin's complete claim set. */
+  replace: (owner: string, sessionIds: readonly SessionId[]) => void
+  /** Release every session claimed by one plugin. */
+  release: (owner: string) => void
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    workspaceSessionClaims: WorkspaceSessionClaims
+  }
+}
+
+function sameIds(left: readonly SessionId[], right: readonly SessionId[]): boolean {
+  return left.length === right.length && left.every((id, index) => id === right[index])
+}
+
+/** Root-scoped implementation owned by ui-workspace. */
+export class WorkspaceSessionClaimsRuntime implements WorkspaceSessionClaims {
+  private readonly byOwner = new Map<string, readonly SessionId[]>()
+  private readonly listeners = new Set<() => void>()
+  private snapshot: readonly SessionId[] = EMPTY_SESSION_IDS
+
+  getSnapshot(): readonly SessionId[] { return this.snapshot }
+
+  subscribe(listener: () => void): () => void {
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  replace(owner: string, sessionIds: readonly SessionId[]): void {
+    const next = [...new Set(sessionIds)]
+    const previous = this.byOwner.get(owner) ?? EMPTY_SESSION_IDS
+    if (sameIds(previous, next)) return
+    if (next.length === 0) this.byOwner.delete(owner)
+    else this.byOwner.set(owner, next)
+    this.publish()
+  }
+
+  release(owner: string): void {
+    if (!this.byOwner.delete(owner)) return
+    this.publish()
+  }
+
+  private publish(): void {
+    const next = [...new Set([...this.byOwner.values()].flat())]
+    if (sameIds(this.snapshot, next)) return
+    this.snapshot = next.length === 0 ? EMPTY_SESSION_IDS : next
+    for (const listener of this.listeners) listener()
+  }
+}
