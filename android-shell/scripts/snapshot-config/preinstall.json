{
  "$comment": "快照预装清单与镜像链（build-snapshot-013.mjs 消费）。targets=Termux 预装包（依赖闭包 BFS 自动展开）；android-tools 为 ADB 2.0 执行客户端；termux 无 licenses 包（LICENSES 由基座/仓库文本兜底）。增删预装包只改本文件。",
  "mirrors": [
    "https://mirrors.tuna.tsinghua.edu.cn/termux/apt/termux-main",
    "https://packages.termux.dev/apt/termux-main"
  ],
  "npmMirrors": ["https://registry.npmjs.org", "https://registry.npmmirror.com"],
  "targets": [
    "python", "python-pip", "perl", "ruby", "ripgrep", "zip", "vim", "openssl", "openssl-tool",
    "zsh", "socat", "busybox", "dpkg", "termux-exec", "termux-elf-cleaner", "termux-keyring",
    "android-tools", "git"
  ],
  "pnpm": { "version": "10.12.1", "pkg": "pnpm" },
  "canvas": {
    "version": "1.0.8",
    "comment": "仅 arm64 装配（npm 无 android-x86_64 triple）；x86_64 维持 attachment-formats 懒加载守卫降级",
    "pkgs": ["@napi-rs/canvas", "@napi-rs/canvas-android-arm64"]
  }
}
